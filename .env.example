# Configure at least one provider. Never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional runtime tuning
AI_PROVIDER_ORDER=groq,gemini
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
AI_MAX_OUTPUT_TOKENS=1200
ALLOWED_ORIGINS=https://www.e-marketingreviews.com,https://e-marketingreviews.com
LOG_LEVEL=INFO

# Optional crawler tuning
SITE_BASE_URL=https://www.e-marketingreviews.com/
MAX_PAGES_TO_CRAWL=300
CRAWL_DELAY_SECONDS=0.25
